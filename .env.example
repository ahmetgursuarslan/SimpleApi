# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env - it is gitignored.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# Authentication -------------------------------------------------------------
# Required for POST/PUT/DELETE on /api/customers. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production, write endpoints return 503 until this is set.
API_KEY=

# Database -------------------------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=simpleapi
DB_PORT=3306
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000
# Enable TLS for any database that is not on localhost.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# CORS -----------------------------------------------------------------------
# Comma-separated list of allowed origins. "*" is rejected in production and
# can never be combined with CORS_CREDENTIALS=true.
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=false

# Rate limiting --------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Reverse proxy --------------------------------------------------------------
# false (default), true, a hop count, or a CIDR list. Leave false unless the app
# really sits behind a proxy - otherwise X-Forwarded-For spoofing defeats the
# rate limiter.
TRUST_PROXY=false

# Request bodies -------------------------------------------------------------
BODY_LIMIT=100kb

# Optional endpoints ---------------------------------------------------------
# Both default to on outside production and off in production.
ENABLE_DOCS=true
ENABLE_ECHO=true

# Swagger --------------------------------------------------------------------
# Set when running behind a proxy or on another host, e.g. https://api.example.com
SWAGGER_SERVER_URL=
